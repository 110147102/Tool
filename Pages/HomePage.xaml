<Page x:Class="WinUI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock 
                Text="图片格式转换" 
                FontSize="34" 
                FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock 
                x:Name="PlaceholderText"
                Text="预览位置"
                FontSize="18"
                Opacity="0.3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Grid.Column="0"/>
            <Border 
                x:Name="PreviewBorder"
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,10,0"
                Visibility="Collapsed">
                <ScrollViewer>
                    <Image 
                        x:Name="PreviewImage" 
                        Stretch="Uniform"
                        MaxHeight="550"/>
                </ScrollViewer>
            </Border>

            <Border CornerRadius="10" 
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#374151"
                    Grid.Column="1">
            <StackPanel               
                Spacing="12"
                Margin="10,10,10,10">

                <TextBlock Text="文件选择"
                           FontSize="20"/>
                <Button 
                    x:Name="SelectButton" 
                    Content="选择要转换的图片" 
                    Click="SelectButton_Click"
                    HorizontalAlignment="Stretch"
                    Height="45"/>

                <TextBlock Text="文件信息"
                           FontSize="20"/>
                <TextBlock Text="文件名称:"
                           FontSize="16"/>
                <TextBlock 
                    x:Name="FileText" 
                    Text="未选择文件" 
                    Opacity="0.6"/>

                <TextBlock Text="文件路径:"
                           FontSize="16"/>
                <TextBlock 
                    x:Name="FilePathText" 
                    Text="" 
                    Opacity="0.4" 
                    FontSize="12" 
                    TextWrapping="Wrap"/>

                <Expander x:Name="FormatExpander"
                          Header="选择输出格式"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          CornerRadius="6">

                        <Expander.Content>
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <RadioButton x:Name="FormatJPG" 
                                         Content="JPG / JPEG" 
                                         GroupName="FormatGroup"
                                         IsChecked="True"
                                         Checked="FormatRadio_Checked"/>

                                <RadioButton x:Name="FormatPNG" 
                                         Content="PNG" 
                                         GroupName="FormatGroup"
                                         Checked="FormatRadio_Checked"/>

                                <RadioButton x:Name="FormatWebP" 
                                         Content="WebP" 
                                         GroupName="FormatGroup"
                                         Checked="FormatRadio_Checked"/>

                                <RadioButton x:Name="FormatBMP" 
                                         Content="BMP" 
                                         GroupName="FormatGroup"
                                         Checked="FormatRadio_Checked"/>

                                <RadioButton x:Name="FormatGIF" 
                                         Content="GIF" 
                                         GroupName="FormatGroup"
                                         Checked="FormatRadio_Checked"/>

                                <RadioButton x:Name="FormatTIFF" 
                                         Content="TIFF" 
                                         GroupName="FormatGroup"
                                         Checked="FormatRadio_Checked"/>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>

                    <Button 
                          x:Name="ConvertButton" 
                          Content="开始转换" 
                          Click="ConvertButton_Click"
                          HorizontalAlignment="Stretch"
                          Height="45"
                          IsEnabled="False"/>
                    <ProgressBar 
                    x:Name="ProgressBar" 
                    Visibility="Collapsed"/>

                <TextBlock 
                    x:Name="StatusText" 
                    Text="就绪" 
                    Opacity="0.6"/>
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>